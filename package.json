{
  "name": "KAVY-SHOP",
  "version": "1.0.0",
  "description": "Shopify Dawn-inspired clothing e-commerce platform",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server.js",
    "import:sanhi": "node server/scripts/import_sanhi_clean.js",
    "seed:pinterest": "node server/scripts/seed_56_real_pinterest_products.js",
    "seed": "node -e \"import('./server/config/database.js').then(m => m.seedDatabase())\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@fontsource/poppins": "^5.1.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "vite": "^5.4.8"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "better-sqlite3@13.0.3": true,
    "sharp@0.33.5": true,
    "esbuild@0.21.5": true
  }
}
